{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/IntegrationGuide","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This SDK is in alpha. Documentation and APIs are subject to change.","type":"text"}]}],"style":"warning","name":"Warning"},{"inlineContent":[{"type":"text","text":"Quadrascan SDK exposes a SwiftUI view that interactively guides a person through a process that collects images of them and returns a 3D model and anthropometric measurements of said person. To use the SDK, add it to your project, provide a configuration, and present the scan view. The scan completes with a result object containing output based on your configuration."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"system_overview"}],"type":"paragraph"},{"type":"heading","anchor":"App-Permissions","level":2,"text":"App Permissions"},{"inlineContent":[{"type":"text","text":"Quadrascan requires camera and photo library access. Add these keys to your app’s Info.plist:"}],"type":"paragraph"},{"code":["<key>NSCameraUsageDescription<\/key>","<string>Required for body scan capture<\/string>","<key>NSPhotoLibraryUsageDescription<\/key>","<string>Required for body scan capture<\/string>"],"type":"codeListing","syntax":"xml"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Both keys are required for app submission.","type":"text"}]}],"style":"note","name":"Note"},{"type":"heading","anchor":"Adding-the-SDK-to-your-App","level":2,"text":"Adding the SDK to your App"},{"type":"heading","anchor":"Using-Swift-Package-Manager","level":3,"text":"Using Swift Package Manager"},{"inlineContent":[{"type":"text","text":"Add Quadrascan to your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/graupel\/ios-quadrascan-sdk.git\", .branch(\"main\"))","]"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Manual-Installation","level":3,"text":"Manual Installation"},{"inlineContent":[{"type":"text","text":"You can integrate the SDK manually from the GitHub Releases page."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Download "},{"code":"Quadrascan-x.x.x.xcframework.zip","type":"codeVoice"},{"type":"text","text":" from the "},{"isActive":true,"identifier":"https:\/\/github.com\/graupel\/ios-quadrascan-sdk\/releases","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Uncompress the zip file and then move the "},{"code":"Quadrascan-x.x.x.xcframework","type":"codeVoice"},{"type":"text","text":" artifact into your project folder."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Open your app’s project file in Xcode and then select your app’s target under target list."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"code":"Quadrascan-x.x.x.xcframework","type":"codeVoice"},{"type":"text","text":" to the “Frameworks, Libraries, and Embedded Content” section in the General tab of your iOS app target, and select “Embed & Sign”."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"SDK-Initialization","level":2,"text":"SDK Initialization"},{"inlineContent":[{"type":"text","text":"Import the SDK and create a configuration:"}],"type":"paragraph"},{"code":["import Quadrascan","","let config = try QuadrascanConfiguration(teamID: \"YOUR_TEAM_ID\",","                                         meshGenerationServiceToken: \"YOUR_MESH_TOKEN\",","                                         measurementServiceToken: \"YOUR_MEASUREMENT_TOKEN\", \/\/ Required if requesting measurements","                                         requestedOutput: [.stlMesh, .measurements]) \/\/ or [.stlMesh], or [.usdzModel], or [.objMesh], or [.usdzModel, .measurements] or [.objMesh, .measurements]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Present "},{"isActive":true,"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView"},{"type":"text","text":" in your SwiftUI hierarchy. Handle the result in the provided closure:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["QuadrascanView(configuration: config) { response in","    \/\/ Handle session result here","}"]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"teamID"},{"type":"text","text":", "},{"type":"codeVoice","code":"meshGenerationServiceToken"},{"type":"text","text":", and "},{"type":"codeVoice","code":"measurementServiceToken"},{"type":"text","text":" are provided by Fitmatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"meshGenerationServiceToken"},{"type":"text","text":" is required for guided capture and photo picker flows."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"measurementServiceToken"},{"type":"text","text":" is required when "},{"type":"codeVoice","code":"requestedOutput"},{"type":"text","text":" includes "},{"type":"codeVoice","code":".measurements"},{"type":"text","text":", and for measurement-only flow."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"requestedOutput"},{"type":"text","text":" to specify which results you need. Use "},{"type":"codeVoice","code":"[.usdzModel, .measurements]"},{"type":"text","text":", "},{"type":"codeVoice","code":"[.stlMesh, .measurements]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[.objMesh, .measurements]"},{"type":"text","text":" to request both a 3D model and anthropometric measurements."}]}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The configuration initializer throws an error if required tokens are missing or invalid. It also throws an error if an invalid combination of "},{"type":"codeVoice","code":"requestedOutput"},{"type":"text","text":" is provided. An example of an invalid combination would be any combination that includes more than one 3d type output. e.g. [.stlMesh, .usdzModel], [.objMesh, .usdzModel], or [.objMesh, .stlMesh]. Only one 3D model format can be specified at a time. Wrap the initialization in a "},{"type":"codeVoice","code":"do-catch"},{"type":"text","text":" block or use "},{"type":"codeVoice","code":"try?"},{"type":"text","text":" for error handling."}]}],"style":"important","type":"aside","name":"Important"},{"level":3,"anchor":"Optional-Configuration","text":"Optional Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"The configuration supports several optional parameters to customize the scanning experience:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"flow"}]},{"type":"text","text":": Choose the entry point for the workflow. Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/guidedCapture"},{"type":"text","text":" (default) to start with AI-guided camera capture, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/cameraCapture"},{"type":"text","text":" to start with manual back-camera 4-pose capture, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/photoPicker"},{"type":"text","text":" to start with photo library selection, or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/measurementOnly(usdzURL:heightInInches:weightInPounds:sessionContext:)"},{"type":"text","text":" to start directly at measurement generation with a USDZ model."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"optionalInputs"}]},{"type":"text","text":": The set of non-mandatory fields collected during the flow (for example "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanOptionalInput\/weight"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanOptionalInput\/email"},{"type":"text","text":", "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanOptionalInput\/customID","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanOptionalInput\/operatorName","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanOptionalInput\/predictedHeight","type":"reference","isActive":true},{"type":"text","text":"). Defaults to an empty set. Inputs that do not apply to the chosen "},{"type":"codeVoice","code":"flow"},{"type":"text","text":" are ignored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"shouldUseImperialUnits"}]},{"type":"text","text":": When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", uses feet\/inches and pounds throughout the UI. When "},{"type":"codeVoice","code":"false"},{"type":"text","text":" (default), uses centimeters and kilograms."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"appearance"}]},{"type":"text","text":": Customize the UI accent color with a "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanAppearance","type":"reference","isActive":true},{"type":"text","text":" object. Set the "},{"type":"codeVoice","code":"accentColor"},{"type":"text","text":" to match your app’s design, which affects buttons and highlights throughout the scan workflow."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"logLevelThreshold"}]},{"type":"text","text":": Control debug logging verbosity using "},{"type":"codeVoice","code":"OSLogType"},{"type":"text","text":". Defaults to "},{"type":"codeVoice","code":".error"},{"type":"text","text":". Set to "},{"type":"codeVoice","code":".debug"},{"type":"text","text":" or "},{"type":"codeVoice","code":".info"},{"type":"text","text":" for more detailed logging during development."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"clientUserID"}]},{"type":"text","text":": Optional user identifier for associating scans with users in your system. Used for analytics and support purposes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"telemetryEnabled"}]},{"type":"text","text":": Controls whether anonymized diagnostic telemetry is sent. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Measurement-Form-Pre-fill","text":"Measurement Form Pre-fill","type":"heading"},{"inlineContent":[{"type":"text","text":"When measurements are requested, the SDK shows a details form before submitting the mesh. You can pre-populate fields by passing values on "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanConfiguration","isActive":true},{"type":"text","text":". Pre-filled values are editable; the values the user submits are returned on "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResult\/MeasurementResult-swift.struct","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"teamID"}]},{"type":"text","text":": Pre-fills the team field. Returned on "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResult\/MeasurementResult-swift.struct\/teamID","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"gender"}]},{"type":"text","text":": Pre-fills the gender picker. Returned on "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResult\/MeasurementResult-swift.struct\/gender","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"operatorName"}]},{"type":"text","text":": Pre-fills the operator name field when "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanOptionalInput\/operatorName","type":"reference","isActive":true},{"type":"text","text":" is included in "},{"type":"codeVoice","code":"optionalInputs"},{"type":"text","text":". Returned on "},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResult\/MeasurementResult-swift.struct\/operatorName","type":"reference","isActive":true},{"type":"text","text":" if provided."}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["let config = try QuadrascanConfiguration(teamID: lastResult.teamID,","                                         operatorName: lastResult.operatorName,","                                         gender: lastResult.gender,","                                         meshGenerationServiceToken: meshToken,","                                         measurementServiceToken: measurementToken,","                                         requestedOutput: [.usdzModel, .measurements],","                                         optionalInputs: [.operatorName]) \/\/ required for operator pre-fill"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"On completion, the response indicates success, failure, or user cancellation."}],"type":"paragraph"},{"level":2,"anchor":"Complete-Example","text":"Complete Example","type":"heading"},{"inlineContent":[{"type":"text","text":"Here’s a complete example showing how to integrate Quadrascan into a SwiftUI view:"}],"type":"paragraph"},{"code":["import SwiftUI","import Quadrascan","import AVFoundation","import Photos","","struct MyView: View {","    @State private var showingScanView = false","    @State private var showingPermissionAlert = false","","    var body: some View {","        Button(\"Start Body Scan\") {","            Task {","                if await requestPermissions() {","                    showingScanView = true","                } else {","                    showingPermissionAlert = true","                }","            }","        }","        .fullScreenCover(isPresented: $showingScanView) {","            scanView","        }","        .alert(\"Permissions Required\", isPresented: $showingPermissionAlert) {","            Button(\"OK\") { }","        } message: {","            Text(\"Camera and photo library access are required for body scanning.\")","        }","    }","","    @ViewBuilder","    private var scanView: some View {","        \/\/ In production, handle configuration errors appropriately for your app","        if let config = try? QuadrascanConfiguration(teamID: \"YOUR_TEAM_ID\",","                                                     meshGenerationServiceToken: \"YOUR_MESH_TOKEN\",","                                                     measurementServiceToken: \"YOUR_MEASUREMENT_TOKEN\",","                                                     requestedOutput: [.usdzModel, .measurements],","                                                     appearance: QuadrascanAppearance(accentColor: .blue),","                                                     optionalInputs: [.weight, .operatorName],","                                                     shouldUseImperialUnits: false) {","            QuadrascanView(configuration: config) { response in","                handleResponse(response)","            }","        } else {","            Text(\"Configuration error\")","        }","    }","","    private func handleResponse(_ response: QuadrascanResponse) {","        switch response {","        case .success(let result):","            print(\"Height: \\(result.heightInInches) inches, Weight: \\(result.weightInPounds, default: \"N\/A\") lbs\")","            if let measurementResult = result.measurementResult {","                print(\"Team: \\(measurementResult.teamID), Gender: \\(measurementResult.gender.rawValue)\")","                if let operatorName = measurementResult.operatorName {","                    print(\"Operator: \\(operatorName)\")","                }","                print(\"Received measurements: \\(measurementResult.measurements)\")","            }","            if let modelData = result.modelData {","                print(\"Received 3D model: \\(modelData.count) bytes\")","            }","        case .failure(let error):","            print(\"Scan failed: \\(error.localizedDescription)\")","        case .cancelled:","            break","        @unknown default:","            break","        }","        showingScanView = false","    }","","    private func requestPermissions() async -> Bool {","        let cameraAuthorized = await requestCameraAuthorization()","        let photoLibraryAuthorized = await requestPhotoLibraryAuthorization()","        return cameraAuthorized && photoLibraryAuthorized","    }","","    private func requestCameraAuthorization() async -> Bool {","        let status = AVCaptureDevice.authorizationStatus(for: .video)","        if status == .authorized { return true }","        if status == .notDetermined { return await AVCaptureDevice.requestAccess(for: .video) }","        return false","    }","","    private func requestPhotoLibraryAuthorization() async -> Bool {","        let status = PHPhotoLibrary.authorizationStatus(for: .readWrite)","        if status == .authorized || status == .limited { return true }","        if status == .notDetermined {","            let newStatus = await PHPhotoLibrary.requestAuthorization(for: .readWrite)","            return newStatus == .authorized || newStatus == .limited","        }","        return false","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Handling-Completion-and-Errors","text":"Handling Completion and Errors","type":"heading"},{"inlineContent":[{"type":"text","text":"Handling the result from "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView","isActive":true},{"type":"text","text":" might look like the following:"}],"type":"paragraph"},{"code":["QuadrascanView(configuration: config) { response in","    switch response {","    case .success(let result):","        \/\/ Calibration inputs are always available","        print(\"Height: \\(result.heightInInches) inches, Weight: \\(result.weightInPounds, default: \"N\/A\") lbs\")","        if let measurementResult = result.measurementResult {","            \/\/ Persist measurementResult.teamID, .gender, and .operatorName for the next session's pre-fill","            \/\/ Process measurementResult.measurements","        }","        if let modelData = result.modelData {","            \/\/ Process 3D model data","        }","        \/\/ Access metadata: result.metadata","    case .failure(let error):","        switch error {","        case .captureError(let underlying):","            \/\/ Camera or capture issues occurred","        case .meshGenerationError(let underlying):","            \/\/ Mesh generation service failure","        case .meshProcessingError(let underlying):","            \/\/ Model processing failure","        case .measurementGenerationError(let underlying):","            \/\/ Measurement service failure","        case .configurationError(let underlying):","            \/\/ Invalid configuration (e.g., missing tokens)","        }","    case .cancelled:","        \/\/ User cancelled the flow","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"On "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResponse\/success(_:)","isActive":true},{"type":"text","text":", handle the "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResult","isActive":true},{"type":"text","text":" according to your needs. It is appropriate to remove the "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView","isActive":true},{"type":"text","text":" from the view hierarchy at this point."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResponse\/cancelled","isActive":true},{"type":"text","text":" the user aborted the flow; reset your UI or state as appropriate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResponse\/failure(_:)","isActive":true},{"type":"text","text":", handle the "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanError","isActive":true},{"type":"text","text":" value."}],"type":"paragraph"},{"level":2,"anchor":"Flow-Customizations","text":"Flow Customizations","type":"heading"},{"inlineContent":[{"type":"text","text":"You can customize the scan UI by providing a "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanAppearance","isActive":true},{"type":"text","text":" in the configuration. Currently, you can set the "},{"type":"codeVoice","code":"accentColor"},{"type":"text","text":" to match your app’s design, which affects buttons and highlights throughout the scan workflow."}],"type":"paragraph"},{"type":"heading","level":2,"text":"User Analytics","anchor":"User-Analytics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK supports optional correlation and telemetry:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Correlation: Pass a "},{"type":"codeVoice","code":"clientUserID"},{"type":"text","text":" when creating your "},{"isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanConfiguration","type":"reference"},{"type":"text","text":" to associate scans with a user in your system."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Telemetry: The "},{"type":"codeVoice","code":"telemetryEnabled"},{"text":" parameter defaults to ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":". When enabled, the SDK sends anonymized diagnostics (for example, success and error statistics). No PII is included. Set it to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to opt out, though this reduces the diagnostic data available for troubleshooting."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Support","anchor":"Support"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the latest SDK release when possible. Newer versions may include performance improvements, new features, and bug fixes."}]}],"kind":"content"}],"kind":"article","metadata":{"color":{"standardColorIdentifier":"purple"},"title":"Integration Guide","roleHeading":"Article","images":[{"type":"card","identifier":"greenhand.png"}],"platforms":[{"introducedAt":"17.0","name":"iOS","beta":false}],"role":"article","modules":[{"name":"Quadrascan"}]},"hierarchy":{"paths":[["doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan"]]},"abstract":[{"type":"text","text":"Integrate Quadrascan to generate 3D models and anthropometric measurements of a subject using a guided, SwiftUI-based scanning flow."}],"sampleCodeDownload":{"kind":"sampleDownload","action":{"isActive":true,"type":"reference","overridingTitle":"Visit","identifier":"https:\/\/github.com\/graupel\/ios-quadrascan-sdk"}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/quadrascan\/integrationguide"]}],"references":{"doc://fitmatch.ai.Quadrascan/documentation/Quadrascan":{"abstract":[{"text":"Generate 3D models and anthropometric measurements from body scans.","type":"text"}],"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan","role":"collection","type":"topic","url":"\/documentation\/quadrascan","kind":"symbol","images":[{"type":"icon","identifier":"logo.png"}],"title":"Quadrascan"},"https://github.com/graupel/ios-quadrascan-sdk":{"type":"download","identifier":"https:\/\/github.com\/graupel\/ios-quadrascan-sdk","url":"https:\/\/github.com\/graupel\/ios-quadrascan-sdk","checksum":null},"doc://fitmatch.ai.Quadrascan/documentation/Quadrascan/QuadrascanFlow/cameraCapture":{"role":"symbol","url":"\/documentation\/quadrascan\/quadrascanflow\/cameracapture","abstract":[],"title":"QuadrascanFlow.cameraCapture","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"cameraCapture"}],"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/cameraCapture","type":"topic","kind":"symbol"},"doc://fitmatch.ai.Quadrascan/do