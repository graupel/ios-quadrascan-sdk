{"hierarchy":{"paths":[["doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan"]]},"sampleCodeDownload":{"kind":"sampleDownload","action":{"overridingTitle":"Visit","identifier":"https:\/\/github.com\/graupel\/ios-quadrascan-sdk","type":"reference","isActive":true}},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/quadrascan\/integrationguide"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/IntegrationGuide"},"metadata":{"roleHeading":"Article","role":"article","title":"Integration Guide","color":{"standardColorIdentifier":"purple"},"platforms":[{"introducedAt":"17.0","name":"iOS","beta":false}],"images":[{"type":"card","identifier":"greenhand.png"}],"modules":[{"name":"Quadrascan"}]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"This SDK is in alpha. Documentation and APIs are subject to change.","type":"text"}]}],"style":"warning"},{"type":"paragraph","inlineContent":[{"text":"Quadrascan SDK exposes a SwiftUI view that interactively guides a person through a process that collects images of them and returns a 3D model and anthropometric measurements of said person. To use the SDK, add it to your project, provide a configuration, and present the scan view. The scan completes with a result object containing output based on your configuration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"system_overview"}]},{"anchor":"App-Permissions","type":"heading","text":"App Permissions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Quadrascan requires camera and photo library access. Add these keys to your app’s Info.plist:"}]},{"type":"codeListing","syntax":"xml","code":["<key>NSCameraUsageDescription<\/key>","<string>Required for body scan capture<\/string>","<key>NSPhotoLibraryUsageDescription<\/key>","<string>Required for body scan capture<\/string>"]},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Both keys are required for app submission."}],"type":"paragraph"}],"style":"note"},{"anchor":"Adding-the-SDK-to-your-App","type":"heading","text":"Adding the SDK to your App","level":2},{"anchor":"Using-Swift-Package-Manager","type":"heading","text":"Using Swift Package Manager","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add Quadrascan to your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/graupel\/ios-quadrascan-sdk.git\", .branch(\"main\"))","]"]},{"anchor":"Manual-Installation","type":"heading","text":"Manual Installation","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can integrate the SDK manually from the GitHub Releases page."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Download ","type":"text"},{"code":"Quadrascan-x.x.x.xcframework.zip","type":"codeVoice"},{"text":" from the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/graupel\/ios-quadrascan-sdk\/releases","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Uncompress the zip file and then move the "},{"type":"codeVoice","code":"Quadrascan-x.x.x.xcframework"},{"type":"text","text":" artifact into your project folder."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Open your app’s project file in Xcode and then select your app’s target under target list.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"Quadrascan-x.x.x.xcframework"},{"type":"text","text":" to the “Frameworks, Libraries, and Embedded Content” section in the General tab of your iOS app target, and select “Embed & Sign”."}],"type":"paragraph"}]}]},{"anchor":"SDK-Initialization","type":"heading","text":"SDK Initialization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the SDK and create a configuration:"}]},{"type":"codeListing","syntax":"swift","code":["import Quadrascan","","let config = try QuadrascanConfiguration(teamID: \"YOUR_TEAM_ID\",","                                         meshGenerationServiceToken: \"YOUR_MESH_TOKEN\",","                                         measurementServiceToken: \"YOUR_MEASUREMENT_TOKEN\", \/\/ Required if requesting measurements","                                         requestedOutput: [.stlMesh, .measurements]) \/\/ or [.stlMesh], or [.usdzModel], or [.objMesh], or [.usdzModel, .measurements] or [.objMesh, .measurements]"]},{"type":"paragraph","inlineContent":[{"text":"Present ","type":"text"},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView","isActive":true,"type":"reference"},{"text":" in your SwiftUI hierarchy. Handle the result in the provided closure:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["QuadrascanView(configuration: config) { response in","    \/\/ Handle session result here","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"teamID","type":"codeVoice"},{"text":", ","type":"text"},{"code":"meshGenerationServiceToken","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"measurementServiceToken","type":"codeVoice"},{"text":" are provided by Fitmatch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"meshGenerationServiceToken"},{"text":" is required for guided capture and photo picker flows.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"measurementServiceToken"},{"text":" is required when ","type":"text"},{"type":"codeVoice","code":"requestedOutput"},{"text":" includes ","type":"text"},{"type":"codeVoice","code":".measurements"},{"text":", and for measurement-only flow.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"codeVoice","code":"requestedOutput"},{"type":"text","text":" to specify which results you need. Use "},{"type":"codeVoice","code":"[.usdzModel, .measurements]"},{"type":"text","text":", "},{"type":"codeVoice","code":"[.stlMesh, .measurements]"},{"type":"text","text":" or "},{"type":"codeVoice","code":"[.objMesh, .measurements]"},{"type":"text","text":" to request both a 3D model and anthropometric measurements."}]}]}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"The configuration initializer throws an error if required tokens are missing or invalid. It also throws an error if an invalid combination of ","type":"text"},{"code":"requestedOutput","type":"codeVoice"},{"text":" is provided. An example of an invalid combination would be any combination that includes more than one 3d type output. e.g. [.stlMesh, .usdzModel], [.objMesh, .usdzModel], or [.objMesh, .stlMesh]. Only one 3D model format can be specified at a time. Wrap the initialization in a ","type":"text"},{"code":"do-catch","type":"codeVoice"},{"text":" block or use ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":" for error handling.","type":"text"}]}],"style":"important"},{"anchor":"Optional-Configuration","type":"heading","text":"Optional Configuration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The configuration supports several optional parameters to customize the scanning experience:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"flow"}]},{"text":": Choose the entry point for the workflow. Use ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/guidedCapture","isActive":true},{"text":" (default) to start with AI-guided camera capture, ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/cameraCapture","isActive":true},{"text":" to start with manual back-camera 4-pose capture, ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/photoPicker","isActive":true},{"text":" to start with photo library selection, or ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanFlow\/measurementOnly(usdzURL:heightInInches:weightInPounds:sessionContext:)","isActive":true},{"text":" to start directly at measurement generation with a USDZ model.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"shouldShowWeightInput"}],"type":"strong"},{"text":": When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", displays a weight entry field during the flow. Defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"shouldUseImperialUnits"}],"type":"strong"},{"type":"text","text":": When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", uses feet\/inches and pounds throughout the UI. When "},{"code":"false","type":"codeVoice"},{"type":"text","text":" (default), uses centimeters and kilograms."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"appearance","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Customize the UI accent color with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanAppearance"},{"type":"text","text":" object. Set the "},{"type":"codeVoice","code":"accentColor"},{"type":"text","text":" to match your app’s design, which affects buttons and highlights throughout the scan workflow."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"logLevelThreshold","type":"codeVoice"}]},{"type":"text","text":": Control debug logging verbosity using "},{"type":"codeVoice","code":"OSLogType"},{"type":"text","text":". Defaults to "},{"type":"codeVoice","code":".error"},{"type":"text","text":". Set to "},{"type":"codeVoice","code":".debug"},{"type":"text","text":" or "},{"type":"codeVoice","code":".info"},{"type":"text","text":" for more detailed logging during development."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"clientUserID","type":"codeVoice"}]},{"type":"text","text":": Optional user identifier for associating scans with users in your system. Used for analytics and support purposes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"telemetryEnabled","type":"codeVoice"}]},{"type":"text","text":": Controls whether anonymized diagnostic telemetry is sent. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"On completion, the response indicates success, failure, or user cancellation.","type":"text"}]},{"anchor":"Complete-Example","type":"heading","text":"Complete Example","level":2},{"type":"paragraph","inlineContent":[{"text":"Here’s a complete example showing how to integrate Quadrascan into a SwiftUI view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftUI","import Quadrascan","import AVFoundation","import Photos","","struct MyView: View {","    @State private var showingScanView = false","    @State private var showingPermissionAlert = false","","    var body: some View {","        Button(\"Start Body Scan\") {","            Task {","                if await requestPermissions() {","                    showingScanView = true","                } else {","                    showingPermissionAlert = true","                }","            }","        }","        .fullScreenCover(isPresented: $showingScanView) {","            scanView","        }","        .alert(\"Permissions Required\", isPresented: $showingPermissionAlert) {","            Button(\"OK\") { }","        } message: {","            Text(\"Camera and photo library access are required for body scanning.\")","        }","    }","","    @ViewBuilder","    private var scanView: some View {","        \/\/ In production, handle configuration errors appropriately for your app","        if let config = try? QuadrascanConfiguration(teamID: \"YOUR_TEAM_ID\",","                                                     meshGenerationServiceToken: \"YOUR_MESH_TOKEN\",","                                                     measurementServiceToken: \"YOUR_MEASUREMENT_TOKEN\",","                                                     requestedOutput: [.usdzModel, .measurements],","                                                     appearance: QuadrascanAppearance(accentColor: .blue),","                                                     shouldShowWeightInput: true,","                                                     shouldUseImperialUnits: false) {","            QuadrascanView(configuration: config) { response in","                handleResponse(response)","            }","        } else {","            Text(\"Configuration error\")","        }","    }","","    private func handleResponse(_ response: QuadrascanResponse) {","        switch response {","        case .success(let result):","            print(\"Height: \\(result.heightInInches) inches, Weight: \\(result.weightInPounds, default: \"N\/A\") lbs\")","            if let measurements = result.measurementResult?.measurements {","                print(\"Received measurements: \\(measurements)\")","            }","            if let modelData = result.modelData {","                print(\"Received 3D model: \\(modelData.count) bytes\")","            }","        case .failure(let error):","            print(\"Scan failed: \\(error.localizedDescription)\")","        case .cancelled:","            break","        @unknown default:","            break","        }","        showingScanView = false","    }","","    private func requestPermissions() async -> Bool {","        let cameraAuthorized = await requestCameraAuthorization()","        let photoLibraryAuthorized = await requestPhotoLibraryAuthorization()","        return cameraAuthorized && photoLibraryAuthorized","    }","","    private func requestCameraAuthorization() async -> Bool {","        let status = AVCaptureDevice.authorizationStatus(for: .video)","        if status == .authorized { return true }","        if status == .notDetermined { return await AVCaptureDevice.requestAccess(for: .video) }","        return false","    }","","    private func requestPhotoLibraryAuthorization() async -> Bool {","        let status = PHPhotoLibrary.authorizationStatus(for: .readWrite)","        if status == .authorized || status == .limited { return true }","        if status == .notDetermined {","            let newStatus = await PHPhotoLibrary.requestAuthorization(for: .readWrite)","            return newStatus == .authorized || newStatus == .limited","        }","        return false","    }","}"]},{"anchor":"Handling-Completion-and-Errors","type":"heading","text":"Handling Completion and Errors","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handling the result from "},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView","isActive":true},{"type":"text","text":" might look like the following:"}]},{"type":"codeListing","syntax":"swift","code":["QuadrascanView(configuration: config) { response in","    switch response {","    case .success(let result):","        \/\/ Calibration inputs are always available","        print(\"Height: \\(result.heightInInches) inches, Weight: \\(result.weightInPounds, default: \"N\/A\") lbs\")","        if let measurements = result.measurementResult?.measurements {","            \/\/ Process measurements data","        }","        if let modelData = result.modelData {","            \/\/ Process 3D model data","        }","        \/\/ Access metadata: result.metadata","    case .failure(let error):","        switch error {","        case .captureError(let underlying):","            \/\/ Camera or capture issues occurred","        case .meshGenerationError(let underlying):","            \/\/ Mesh generation service failure","        case .meshProcessingError(let underlying):","            \/\/ Model processing failure","        case .measurementGenerationError(let underlying):","            \/\/ Measurement service failure","        case .configurationError(let underlying):","            \/\/ Invalid configuration (e.g., missing tokens)","        }","    case .cancelled:","        \/\/ User cancelled the flow","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"On ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResponse\/success(_:)","isActive":true},{"text":", handle the ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResult","isActive":true},{"text":" according to your needs. It is appropriate to remove the ","type":"text"},{"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView","isActive":true},{"text":" from the view hierarchy at this point.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResponse\/cancelled"},{"type":"text","text":" the user aborted the flow; reset your UI or state as appropriate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanResponse\/failure(_:)"},{"type":"text","text":", handle the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanError"},{"type":"text","text":" value."}]},{"anchor":"Flow-Customizations","type":"heading","text":"Flow Customizations","level":2},{"type":"paragraph","inlineContent":[{"text":"You can customize the scan UI by providing a ","type":"text"},{"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanAppearance","isActive":true,"type":"reference"},{"text":" in the configuration. Currently, you can set the ","type":"text"},{"code":"accentColor","type":"codeVoice"},{"text":" to match your app’s design, which affects buttons and highlights throughout the scan workflow.","type":"text"}]},{"anchor":"User-Analytics","type":"heading","text":"User Analytics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK supports optional correlation and telemetry:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Correlation: Pass a "},{"type":"codeVoice","code":"clientUserID"},{"type":"text","text":" when creating your "},{"isActive":true,"type":"reference","identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanConfiguration"},{"type":"text","text":" to associate scans with a user in your system."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Telemetry: The "},{"type":"codeVoice","code":"telemetryEnabled"},{"type":"text","text":" parameter defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":". When enabled, the SDK sends anonymized diagnostics (for example, success and error statistics). No PII is included. Set it to "},{"type":"codeVoice","code":"false"},{"type":"text","text":" to opt out, though this reduces the diagnostic data available for troubleshooting."}],"type":"paragraph"}]}]},{"anchor":"Support","type":"heading","text":"Support","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the latest SDK release when possible. Newer versions may include performance improvements, new features, and bug fixes."}]}]}],"abstract":[{"type":"text","text":"Integrate Quadrascan to generate 3D models and anthropometric measurements of a subject using a guided, SwiftUI-based scanning flow."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","references":{"logo.png":{"identifier":"logo.png","variants":[{"url":"\/images\/fitmatch.ai.Quadrascan\/logo@2x.png","traits":["2x","light"]}],"type":"image","alt":"A technology icon representing the Quadrascan framework."},"doc://fitmatch.ai.Quadrascan/documentation/Quadrascan/QuadrascanView":{"type":"topic","abstract":[{"type":"text","text":"A SwiftUI view that presents the Quadrascan workflows."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QuadrascanView"}],"identifier":"doc:\/\/fitmatch.ai.Quadrascan\/documentation\/Quadrascan\/QuadrascanView","title":"QuadrascanView","url":"\/documentation\/quadrascan\/quadrascanview","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"QuadrascanView"}],"kind":"symbol"},"system_overview":{"identifier":"system_overview","variants":[{"url":"\/images\/fitmatch.ai.Quadrascan\/system_overview@2x.png","traits":["2x","light"]}],"type":"image","alt":"A diagram of an app integrated with Quadrascan SDK."},"doc://fitmatch.ai.Quadrascan/documentation/Quadrascan/QuadrascanConfiguration":{"kind":"symbol","url":"\/documentation\/quadrascan\/quadrascanconfiguration","type":"topic","abstract":[{"type":"text","text":"Configuration object used to initialize a Quadrascan ses